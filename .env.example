# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
ATESSA_API_KEY=  # Unified AI API gateway - access Claude, GPT, Gemini, DeepSeek, and more
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Data Providers
# Alpha Vantage: Stock data, fundamentals, technical indicators, news
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Crypto Data Providers
# CoinGecko: Free crypto data (market cap, price, social metrics, DeFi)
# Pro plan optional for higher rate limits: https://www.coingecko.com/en/api/pricing
# Note: Free tier doesn't require API key for basic endpoints
#COINGECKO_API_KEY=

# CoinMarketCap: Crypto market data, quotes, rankings
# Get your free key at: https://coinmarketcap.com/api/
#COINMARKETCAP_API_KEY=

# Glassnode: On-chain analytics (active addresses, MVRV, network metrics)
# Get your key at: https://studio.glassnode.com/settings/api
#GLASSNODE_API_KEY=

# Messari: Crypto research, asset profiles, qualitative analysis
# Get your key at: https://messari.io/api/docs
#MESSARI_API_KEY=

# DeFiLlama: DeFi protocol TVL, stablecoin data (no API key required)
# API docs: https://defillama.com/docs/api

# Blockchain.com: Bitcoin/crypto data and stats
#BLOCKCHAIN_COM_API_KEY=

# Binance: Crypto exchange market data (OHLCV, orderbook, trades)
# Free tier with rate limits (1200 requests/minute)
# Get your key at: https://www.binance.com/en/my/settings/api-management
# Note: API key optional for public market data endpoints
#BINANCE_API_KEY=
#BINANCE_SECRET_KEY=
